{
  "name": "İzsiz Foto",
  "short_name": "İzsiz",
  "description": "Fotoğraf ve MP4/MOV/WebM/AVI videolardaki gömülü verileri cihazında temizle; HEIC ve HEIF fotoğrafları PNG, JPEG veya WebP'ye dönüştür.",
  "lang": "tr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0c1318",
  "theme_color": "#0c1318",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [ { "name": "photos", "accept": ["image/*", "video/mp4", "video/quicktime", "video/webm", "video/x-msvideo"] } ] }
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
